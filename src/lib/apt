# What the commands know of an apt repository: its settings and the suite a version goes to. Sourced by helpers, not run.

# A setting of the repository (APT_REPO_HOST, APT_REPO_PATH, APT_REPO_DIST, APT_REPO_PRERELEASE_DIST): the environment (the
# .env of the project) wins, else the .env of the repository
apt_setting() { # name
    if [[ -n "${!1:-}" ]]; then
        printf '%s' "${!1}"
        return 0
    fi
    [[ -f "${APT_REPO_DIR:-}/.env" ]] || return 0
    (
        set +u
        source "$APT_REPO_DIR/.env" >/dev/null 2>&1
        printf '%s' "${!1:-}"
    )
}

# The suite a package version goes to: the pre-releases (a ~ in the version of a package, 1.2.3~beta.1) to
# APT_REPO_PRERELEASE_DIST when the repository has one, the others to APT_REPO_DIST (default stable). A - is the revision
# of Debian (0.9.3.0-1), not a pre-release: the version of a tag (1.2.3-beta.1) is made one first, 1.2.3~beta.1
apt_dist_of() { # package version
    local pre
    pre=$(apt_setting APT_REPO_PRERELEASE_DIST)
    if [[ $1 == *~* && -n "$pre" ]]; then
        echo "$pre"
    else
        pre=$(apt_setting APT_REPO_DIST)
        echo "${pre:-stable}"
    fi
}
