# What the commands know of an apt repository: its settings and the component a version goes to. Sourced by helpers.

# A setting of the repository: the environment (the .env of the project) wins, else the .env of the repository.
apt_setting() { # name
    if [[ -n "${!1:-}" ]]; then
        printf '%s' "${!1}"
        return 0
    fi
    [[ -f "${APT_REPO_DIR:-}/.env" ]] || return 0
    (
        set +u
        source "$APT_REPO_DIR/.env" >/dev/null 2>&1
        printf '%s' "${!1:-}"
    )
}

# The component for a version. A pre-release has a ~ (1.2.3~beta.1) or a name after the - (1.2.3-beta.1), not a number
# (0.9.3.0-1 is a Debian revision).
apt_component_of() { # version
    local pre stable
    stable=$(apt_setting APT_REPO_COMPONENT)
    stable=${stable:-stable}
    pre=$(apt_setting APT_REPO_PRERELEASE_COMPONENT)
    if [[ ($1 == *~* || $1 =~ -[^0-9]) && -n "$pre" ]]; then
        echo "$pre"
    else
        echo "$stable"
    fi
}

# Project settings take precedence over legacy repository rules and the main default.
apt_distributions() { # version [package]
    local destinations=${APT_REPO_DIST:-}
    if [[ $1 == *~* || $1 =~ -[^0-9] ]]; then
        destinations=${APT_REPO_PRERELEASE_DIST:-$destinations}
    fi
    if [[ -n "$destinations" ]]; then
        printf '%s\n' "$destinations"
    else
        apt_codenames_of "${2:-}" "$(apt_component_of "$1")"
    fi
}

# Resolve a package name using the ordered rules in conf/package-routes.
# A component-qualified rule has: pattern component=<name> codename [codename...].
apt_codenames_of() { # package [component]
    local pattern second destinations route_component component=${2:-$(apt_setting APT_REPO_COMPONENT)}
    component=${component:-stable}
    [[ -r "${APT_REPO_DIR:-}/conf/package-routes" ]] || { echo main; return; }
    while read -r pattern second destinations || [[ -n "${pattern:-}" ]]; do
        [[ -z "$pattern" || "$pattern" == \#* ]] && continue
        if [[ "$1" == $pattern ]]; then
            if [[ "$second" == component=* ]]; then
                route_component=${second#component=}
                [[ "$route_component" == "$component" ]] || continue
                echo "$destinations"
            else
                echo "$second${destinations:+ $destinations}"
            fi
            return
        fi
    done <"$APT_REPO_DIR/conf/package-routes"
    echo main
}

# The first destination is the display/default codename for older callers.
apt_codename_of() { # package [component]
    apt_codenames_of "$1" "${2:-}" | awk '{print $1}'
}

apt_tests_codename() { local value; value=$(apt_setting APT_REPO_TESTS_DIST); echo "${value:-tests}"; }
apt_tests_component() { local value; value=$(apt_setting APT_REPO_TESTS_COMPONENT); echo "${value:-tests}"; }

# Whether a package file's exact version is registered in the requested component.
apt_has_package() { # repository codename component package.deb
    local file name version
    file=$(basename "$4" .deb)
    name=${file%%_*}
    version=${file#*_}
    version=${version%_*}
    reprepro -b "$1" list "$2" "$name" | awk -F'|' -v c="$2" -v p="$3" -v n="$name" -v v="$version" '
        $1 == c && $2 == p { entry = $3; sub(/^[^:]*: /, "", entry); if (entry == n " " v) found = 1 }
        END { exit !found }
    '
}
