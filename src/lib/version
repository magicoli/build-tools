# How a project numbers its versions: the one in progress, the one that follows a release. Sourced by common, not run.

# The latest version tag (1.2.3, v1.2.3, 1.2.3-beta.1), without the v; nothing when there is none
last_tag() {
	git describe --tags --abbrev=0 --match '[0-9]*' --match 'v[0-9]*' 2>/dev/null | sed 's/^v//' || true
}

# The version of composer.json, if it has one
composer_version() {
	sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' composer.json 2>/dev/null | head -1
}

# The version after a release: 3.0.0-beta.4 -> 3.0.0-beta.5, 1.1.2 -> 1.1.3-dev
next_version() { # version
	if [[ $1 =~ ^(.*-[a-z]+\.)([0-9]+)$ ]]; then
		echo "${BASH_REMATCH[1]}$((BASH_REMATCH[2] + 1))"
	elif [[ $1 =~ ^([0-9]+\.[0-9]+\.)([0-9]+)$ ]]; then
		echo "${BASH_REMATCH[1]}$((BASH_REMATCH[2] + 1))-dev"
	else
		return 1
	fi
}

# The version in progress: .version, else the version of composer.json when it is ahead of the last tag, else the one that
# follows the last tag; fails when there is none of them
current_version() {
	local last composer
	if [[ -f .version ]]; then
		tr -d '[:space:]' <.version
		return 0
	fi
	last=$(last_tag)
	composer=$(composer_version)
	if [[ -n $composer && $composer != "$last" && (-z $last || $(printf '%s\n%s\n' "$last" "$composer" | sort -V | tail -1) == "$composer") ]]; then
		[[ $composer == *-* ]] && echo "$composer" || echo "$composer-dev"
	elif [[ -n $last ]]; then
		next_version "$last"
	else
		return 1
	fi
}
