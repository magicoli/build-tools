#!/usr/bin/env bash
# The version of this build of the project, as VERSION= and DEB_VERSION= lines, what packaging/*.yaml expand: the tag when HEAD is on
# a version tag (v1.1.1 or 1.1.1), else the version in progress (see current_version in src/lib/version, a pre-release such
# as 1.1.2-dev) with the number of commits and the hash of HEAD, 1.1.2-dev.14+g1a2b3c4 (g is for git, as git describe
# writes it). Changed files add .dirty (commit before a build you keep: the hash must exist).

set -e
source "$(dirname "$(realpath "$0")")/../src/lib/common"

if tag=$(git describe --tags --exact-match --match 'v[0-9]*' --match '[0-9]*' 2>/dev/null); then
    version=${tag#v}
    git diff --quiet HEAD || version+=+dirty
else
    base=$(current_version) || die "no version: add .version, a version to composer.json, or tag one"
    [[ "$base" == *-* ]] || base=$base-dev
    dirty=
    git diff --quiet HEAD || dirty=.dirty
    version=$base.$(git rev-list --count HEAD)+g$(git rev-parse --short HEAD)$dirty
fi

echo "VERSION=$version"
echo "DEB_VERSION=${version/-/\~}"
