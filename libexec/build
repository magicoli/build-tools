#!/usr/bin/env bash
# Builds what the project distributes into dist/, from the committed tree (commit first: the version carries the hash of
# HEAD): the Debian packages (apt-package, from the definitions of packaging/*.yaml) and the zip.
#
#   build-tools build                      every format the project has
#   build-tools build zip                  the zip, dist/<project>-<version>.zip
#   build-tools build deb [package...]     the Debian packages, all of packaging/*.yaml or the ones named
#
# DIRTY=1 builds the last commit even when files are changed.

set -e
source "$(dirname "$(realpath "$0")")/../src/lib/common"

formats=()
packages=()
for word in "$@"; do
	case $word in
	deb | zip) formats+=("$word") ;;
	*) packages+=("$word") ;;
	esac
done
if [[ ${#formats[@]} -eq 0 ]]; then
	if [[ ${#packages[@]} -gt 0 ]]; then
		formats=(deb)
	else
		ls packaging/*.yaml >/dev/null 2>&1 && formats+=(deb)
		formats+=(zip)
	fi
fi

# A build is made from the last commit, and from composer.lock when there is one: both are checked, not left to be remembered
if [[ -z "${DIRTY:-}" && -n "$(git status --porcelain --untracked-files=no)" ]]; then
	die "commit your changes first, a build is made from the last commit (DIRTY=1 builds it anyway):
$(git status --short --untracked-files=no)"
fi
if [[ -f composer.json ]] && ! composer validate --no-check-publish --no-check-all --no-interaction >/dev/null 2>&1; then
	die "composer.lock is not up to date with composer.json (composer update the packages that changed, commit):
$(composer validate --no-check-publish --no-check-all --no-interaction 2>&1 || true)"
fi
# (the links to the folders git ignores, which the release makes in its own folder, are not files of the project)
untracked=$(git ls-files --others --exclude-standard | while IFS= read -r file; do [[ -L "$file" ]] || echo "$file"; done)
[[ -z "$untracked" ]] || log "note: files git does not track are not in the build: $(tr '\n' ' ' <<<"$untracked")"

name=$(project_name)
mkdir -p dist

for format in "${formats[@]}"; do
	case $format in
	deb)
		require nfpm
		# dist/ holds the build just made of the packages that carry the version of the project, not the former ones
		for definition in packaging/*.yaml; do
			package=$(sed -n 's/^name: *//p' "$definition" | head -1)
			[[ ${#packages[@]} -eq 0 || " ${packages[*]} " == *" $package "* ]] || continue
			grep -qE '\$\{(DEB_)?VERSION\}' "$definition" || continue
			rm -f "dist/${package}_"*.deb
		done
		"$BUILD_TOOLS/bin/apt-package" "${packages[@]}"
		;;
	zip)
		rm -f "dist/$name-"*.zip
		"$BUILD_TOOLS/libexec/zip"
		;;
	esac
done

success "Built from the commit $(git rev-parse --short HEAD), ${DIRTY:+with uncommitted changes, }\"$(git log -1 --format=%s)\"."
