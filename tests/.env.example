# Settings of the tests, copied to tests/.env (git-ignored) by tests/bootstrap.sh on the first run.

# Words that must not appear in the files of the repository (names of your hosts, grids, projects...), separated by spaces.
# They are private: this list stays here, never in a file of the repository.
# PRIVATE_WORDS="word another"

# Files where some of these words are meant to be (e.g. the author in composer.json), separated by spaces
# PRIVATE_SKIP="composer.json composer.lock"
