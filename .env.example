# Settings of a project that uses build-tools: copy this file as .env in the project (git-ignored) and edit it.

# The apt repository the project publishes to: the local clone (conf/distributions, db, public). Another project can
# publish to another repository, the one its .env names.
# APT_REPO_DIR=/path/to/the/apt-repository

# What the repository itself needs can be in its own .env (APT_REPO_DIR/.env) instead, shared by every project that
# publishes to it: the ssh host serving it, its clone on that host, the suite of the releases, the suite of the
# pre-releases (the versions with a ~), and the fields the package definitions leave out
# APT_REPO_HOST=apt.example.com
# APT_REPO_PATH=/var/www/apt-repo
# APT_REPO_DIST=stable
# APT_REPO_PRERELEASE_DIST=unstable
# DEB_MAINTAINER="Name <maintainer@example.com>"
# DEB_VENDOR=Vendor
# DEB_URL=https://example.com/project

# The remote the tags and the releases are pushed to (default: github)
# RELEASE_REMOTE=github
